<?xml version="1.0" encoding="utf-8"?>
<!-- The Connected edition: network features for the user's own server. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Is the phone on Wi-Fi or mobile data ("Use mobile data" setting)? -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The music server is the user's own, reached over WireGuard (already
         encrypted) or the home network, usually by IP address over plain HTTP.
         LocalBeat only ever connects to the address set in Settings. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
