<?xml version="1.0" encoding="utf-8"?>
<!-- The Connected edition: network features for the user's own server. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Is the phone on Wi-Fi or mobile data ("Use mobile data" setting)? -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The music server is the user's own, reached over WireGuard (already
         encrypted) or the home network, usually by IP address over plain HTTP.
         LocalBeat only ever connects to the address set in Settings. -->
    <application android:usesCleartextTraffic="true">
        <!-- Music server links (localbeat://connect?server=…&user=…&secret=…):
             the second QR code from LocalBeatServer's setup page or
             localbeat-people, opened by the phone's camera. LocalBeat asks
             before using them. The offline edition doesn't declare this. -->
        <activity android:name="com.jimboyo.localbeat.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="localbeat" android:host="connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
